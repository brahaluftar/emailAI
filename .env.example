# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional extra instructions for the agent (tone, language, signature...)
AGENT_INSTRUCTIONS=Write concise, polite replies in the language of the incoming e-mail.
TIMEZONE=UTC

# Single unified calendar (ICS file; subscribe to it or import it anywhere)
CALENDAR_FILE=data/calendar.ics

# Comma separated account ids; each needs ACCOUNT_<ID>_* variables
ACCOUNTS=PERSONAL
ACCOUNT_PERSONAL_WEBLOGIN=https://mail.example.com
ACCOUNT_PERSONAL_EMAIL=me@example.com
ACCOUNT_PERSONAL_PASSWORD=
ACCOUNT_PERSONAL_PROTOCOL=imap
ACCOUNT_PERSONAL_HOST=imap.example.com
ACCOUNT_PERSONAL_PORT=993
ACCOUNT_PERSONAL_ENCRYPTION=ssl
ACCOUNT_PERSONAL_DRAFTS_FOLDER=Drafts
